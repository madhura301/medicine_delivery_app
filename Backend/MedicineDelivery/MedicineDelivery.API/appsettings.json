{
  "DatabaseProvider": "PostgreSQL",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=MedicineDeliveryNew;Username=postgres;Password=123;Include Error Detail=true;",
    "PostgresConnection": "Host=localhost;Port=5432;Database=MedicineDeliveryNew;Username=postgres;Password=123;Include Error Detail=true;"
  },
  "JwtSettings": {
    "SecretKey": "ThisIsAVeryLongSecretKeyThatShouldBeAtLeast32CharactersLong",
    "Issuer": "MediMart.API",
    "Audience": "MediMart.API.Users",
    "ExpiryInHours": 1
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.File", "Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/medicine-delivery-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}",
          "shared": true,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "buffered": false
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId", "WithProcessId"]
  },
  "AllowedHosts": "*",
  "Cors": {
    "//": "M-01: browser origins allowed to call this API. Empty = no cross-origin browser access (mobile app unaffected). Set per environment via Cors__AllowedOrigins.",
    "AllowedOrigins": []
  },
  "OtpSettings": {
    "ExpiryMinutes": "5",
    "MaxAttempts": "5"
  },
  "SmsSettings": {
    "Provider": "Console",
    "AuthKey": "SET_VIA_ENV_SmsSettings__AuthKey",
    "OtpTemplateId": "SET_VIA_ENV_SmsSettings__OtpTemplateId",
    "OrderOtpTemplateId": "SET_VIA_ENV_SmsSettings__OrderOtpTemplateId",
    "PaymentTemplateId": "SET_VIA_ENV_SmsSettings__PaymentTemplateId",
    "SenderId": "PHARMA"
  },
  "RazorpaySettings": {
    "KeyId": "rzp_test_SthEup8MNI3Jwq",
    "KeySecret": "aImFVmNR9EIlfQV4WGKZIh2H",
    "Currency": "INR",
    "ActivationFee": 14999,
    "ActivationGstPercent": 18,
    "PlatformFeeGstPercent": 18,
    "WebhookSecret": "",
    "RouteEnabled": true,
    "ConvenienceFee": 20,
    "TransferOnHold": false,
    "BusinessType": "individual"
  },
  "FileStorage": {
    "Provider": "Azure",
    "Azure": {
      "ConnectionString": "SET_VIA_ENV_FileStorage__Azure__ConnectionString",
      "ContainerName": "image",
      "UseSasUrl": false,
      "SasExpiryMinutes": 60
    }
  }
}
